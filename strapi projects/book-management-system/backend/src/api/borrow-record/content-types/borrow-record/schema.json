{
  "kind": "collectionType",
  "collectionName": "borrow_records",
  "info": {
    "singularName": "borrow-record",
    "pluralName": "borrow-records",
    "displayName": "Borrow Record"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "required": true,
      "inversedBy": "borrow_records"
    },
    "book": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book.book",
      "required": true,
      "inversedBy": "borrow_records"
    },
    "borrow_date": {
      "type": "date",
      "required": true
    },
    "return_date": {
      "type": "date"
    },
    "due_date": {
      "type": "date",
      "required": true
    },
    "lend_status": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "Borrowed",
        "Returned",
        "Late"
      ]
    }
  }
}
